              "humor_style": ["observational comedy", "situational humor", "self-deprecating", "absurd comedy"],
              "setup_punchline": ["classic joke structure", "surprise reveal", "expectation subversion", "callback humor"],
              "relatable_scenario": ["everyday situation", "universal experience", "common frustration", "shared moment"],
              "timing_emphasis": ["perfect comedic timing", "build-up and release", "rhythm-based", "pause utilization"]
            },
            "optimization": {
              "entertainment_keywords": ["funny", "hilarious", "entertaining", "clever"],
              "shareability_focus": "humor-driven"
            }
          }
        }
