{
  "prompt_templates": {
    "version": "1.0.0",
    "last_updated": "2025-09-10",
    "categories": {
      "lifestyle": {
        "instagram_feed": {
          "modern_minimal": {
            "id": "lifestyle_ig_minimal_001",
            "base_prompt": "Modern minimalist lifestyle photography of {subject} in {clean_space}, natural lighting, {neutral_palette} color palette, contemporary aesthetic, professional styling, serene atmosphere",
            "variables": {
              "subject": ["young professional", "creative individual", "entrepreneur", "wellness enthusiast"],
              "clean_space": ["modern apartment", "minimalist studio", "bright loft", "contemporary office"],
              "neutral_palette": ["warm whites and beiges", "cool grays and whites", "soft pastels", "monochromatic tones"]
            },
            "optimization": {
              "style_keywords": ["clean", "minimal", "contemporary", "sophisticated"],
              "lighting": "natural window light preferred",
              "composition": "negative space emphasis"
            }
          },
          "bohemian_artistic": {
            "id": "lifestyle_ig_boho_001",
            "base_prompt": "Bohemian lifestyle image featuring {subject} in {artistic_setting}, warm golden lighting, {rich_colors} palette, artistic textures, creative atmosphere, layered composition",
            "variables": {
              "subject": ["creative artist", "free spirit", "bohemian lifestyle", "artistic soul"],
              "artistic_setting": ["eclectic studio", "vintage space", "plant-filled room", "artistic workshop"],
              "rich_colors": ["earthy terracotta and sage", "jewel tones", "warm sunset colors", "deep burgundy and gold"]
            },
            "optimization": {
              "style_keywords": ["artistic", "creative", "warm", "textured"],
              "lighting": "golden hour or warm artificial",
              "composition": "layered with visual interest"
            }
          }
        },
        "tiktok_vertical": {
          "authentic_relatable": {
            "id": "lifestyle_tiktok_authentic_001",
            "base_prompt": "Authentic vertical lifestyle video of {activity} in {real_space}, natural lighting, {genuine_emotion} energy, relatable moment, {casual_style} aesthetic, TikTok-native feel",
            "variables": {
              "activity": ["morning routine", "workspace setup", "creative process", "daily life moment"],
              "real_space": ["actual bedroom", "real kitchen", "home office", "favorite cafe"],
              "genuine_emotion": ["excited", "focused", "content", "motivated"],
              "casual_style": ["effortless", "comfortable", "unpretentious", "natural"]
            },
            "optimization": {
              "authenticity_focus": true,
              "relatability_keywords": ["real", "honest", "genuine", "unfiltered"],
              "energy_level": "medium to high"
            }
          }
        }
      },
      "business": {
        "linkedin_professional": {
          "thought_leadership": {
            "id": "business_li_thought_001",
            "base_prompt": "Professional thought leadership image illustrating {business_concept} in {corporate_environment}, executive lighting, {authoritative_colors} palette, sophisticated composition, industry expertise visual",
            "variables": {
              "business_concept": ["strategic planning", "market innovation", "team leadership", "digital transformation"],
              "corporate_environment": ["modern boardroom", "executive office", "business conference", "strategic planning room"],
              "authoritative_colors": ["professional navy and white", "corporate blue and gray", "sophisticated black and gold", "trustworthy blue and silver"]
            },
            "optimization": {
              "authority_keywords": ["professional", "executive", "strategic", "authoritative"],
              "credibility_focus": true,
              "industry_relevance": "high"
            }
          },
          "data_insights": {
            "id": "business_li_data_001",
            "base_prompt": "Data-driven business visualization showing {data_story}, {professional_chart_style} presentation, {clean_design} aesthetic, {business_colors} palette, analytical clarity focus",
            "variables": {
              "data_story": ["growth metrics", "market analysis", "performance trends", "strategic insights"],
              "professional_chart_style": ["clean infographic", "executive dashboard", "analytical visualization", "business intelligence"],
              "clean_design": ["minimal modern", "corporate professional", "sophisticated clean", "data-focused"],
              "business_colors": ["corporate blue gradients", "professional gray scale", "success green accents", "analytical blue tones"]
            },
            "optimization": {
              "clarity_keywords": ["clear", "analytical", "professional", "insightful"],
              "data_focus": true,
              "business_appropriate": true
            }
          }
        },
        "instagram_business": {
          "behind_scenes": {
            "id": "business_ig_bts_001",
            "base_prompt": "Behind-the-scenes business content showing {work_activity} in {professional_space}, authentic workspace lighting, {approachable_professional} style, team collaboration focus",
            "variables": {
              "work_activity": ["team brainstorming", "product development", "creative planning", "strategy meeting"],
              "professional_space": ["modern office", "creative workspace", "collaboration area", "innovation lab"],
              "approachable_professional": ["friendly professional", "accessible expertise", "human-centered business", "relatable professionalism"]
            },
            "optimization": {
              "authenticity_balance": "professional yet human",
              "engagement_style": "approachable expertise"
            }
          }
        }
      },
      "product": {
        "e_commerce": {
          "hero_shots": {
            "id": "product_ecom_hero_001",
            "base_prompt": "Product hero shot of {product_type} on {premium_surface}, {commercial_lighting} lighting, {clean_background}, sharp focus, commercial photography quality, purchase-intent optimized",
            "variables": {
              "product_type": ["tech gadget", "beauty product", "fashion accessory", "home decor item", "lifestyle product"],
              "premium_surface": ["marble countertop", "white seamless", "textured fabric", "wooden surface", "glass platform"],
              "commercial_lighting": ["soft box studio", "natural bright", "professional three-point", "clean even"],
              "clean_background": ["pure white", "subtle gradient", "minimal texture", "neutral tone"]
            },
            "optimization": {
              "conversion_focus": true,
              "product_clarity": "maximum detail",
              "purchase_psychology": "desire creation"
            }
          },
          "lifestyle_context": {
            "id": "product_ecom_lifestyle_001",
            "base_prompt": "Lifestyle product photography showing {product} in {usage_context}, natural environment lighting, {aspirational_setting}, {target_demographic} using product, lifestyle integration focus",
            "variables": {
              "product": ["skincare routine", "tech in workspace", "fashion styling", "home organization", "wellness product"],
              "usage_context": ["daily routine", "work environment", "social setting", "home space", "active lifestyle"],
              "aspirational_setting": ["beautiful modern home", "stylish workspace", "trendy cafe", "scenic outdoor", "luxury environment"],
              "target_demographic": ["young professional", "creative millennial", "wellness enthusiast", "style-conscious individual"]
            },
            "optimization": {
              "aspiration_keywords": ["desirable", "lifestyle", "aspirational", "premium"],
              "relatability_balance": "attainable luxury"
            }
          }
        },
        "social_proof": {
          "user_generated_style": {
            "id": "product_ugc_style_001",
            "base_prompt": "User-generated content style image of {product_experience}, {authentic_setting} environment, natural casual lighting, {genuine_satisfaction} emotion, realistic usage scenario",
            "variables": {
              "product_experience": ["unboxing moment", "first use experience", "daily routine integration", "problem-solving moment"],
              "authentic_setting": ["real home", "actual workspace", "genuine lifestyle", "true environment"],
              "genuine_satisfaction": ["delighted surprise", "satisfied contentment", "excited discovery", "relieved solution"]
            },
            "optimization": {
              "authenticity_keywords": ["real", "genuine", "authentic", "honest"],
              "trust_building": true
            }
          }
        }
      },
      "educational": {
        "tutorial_content": {
          "step_by_step": {
            "id": "educational_tutorial_001",
            "base_prompt": "Educational tutorial visualization of {learning_topic}, {instructional_style} presentation, {clear_progression} flow, {visual_aid} elements, knowledge transfer optimized",
            "variables": {
              "learning_topic": ["creative skill", "business process", "technical knowledge", "life skill", "professional development"],
              "instructional_style": ["step-by-step breakdown", "visual demonstration", "comparative analysis", "hands-on learning"],
              "clear_progression": ["numbered sequence", "visual timeline", "progressive difficulty", "milestone markers"],
              "visual_aid": ["diagrams and charts", "before-after comparisons", "highlighted key points", "interactive elements"]
            },
            "optimization": {
              "learning_keywords": ["clear", "instructional", "educational", "helpful"],
              "comprehension_focus": true
            }
          },
          "quick_tips": {
            "id": "educational_tips_001",
            "base_prompt": "Quick tip visualization about {tip_category}, {attention_grabbing} design, {actionable_advice} focus, {memorable_presentation} style, immediate value delivery",
            "variables": {
              "tip_category": ["productivity hack", "creative technique", "business insight", "wellness tip", "technology shortcut"],
              "attention_grabbing": ["bold visual contrast", "surprising fact presentation", "problem-solution format", "curiosity gap opening"],
              "actionable_advice": ["specific steps", "practical application", "immediate implementation", "tangible results"],
              "memorable_presentation": ["visual metaphor", "story-driven", "relatable example", "impactful statistics"]
            },
            "optimization": {
              "value_keywords": ["useful", "practical", "actionable", "valuable"],
              "shareability": "high practical value"
            }
          }
        },
        "infographic_style": {
          "data_storytelling": {
            "id": "educational_infographic_001",
            "base_prompt": "Infographic design presenting {information_topic}, {visual_hierarchy} layout, {data_visualization} elements, {engaging_design} aesthetic, information clarity maximized",
            "variables": {
              "information_topic": ["industry statistics", "process explanation", "comparison analysis", "trend visualization", "educational facts"],
              "visual_hierarchy": ["clear information flow", "progressive disclosure", "importance-based sizing", "guided reading path"],
              "data_visualization": ["charts and graphs", "icon representations", "comparative visuals", "statistical displays"],
              "engaging_design": ["modern minimal", "colorful engaging", "professional clean", "creative illustrated"]
            },
            "optimization": {
              "information_clarity": true,
              "visual_appeal": "education-focused",
              "retention_optimization": true
            }
          }
        }
      },
      "entertainment": {
        "viral_content": {
          "trend_based": {
            "id": "entertainment_viral_001",
