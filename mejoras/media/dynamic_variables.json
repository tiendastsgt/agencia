          },
          "accessibility_level": {
            "type": "inclusive",
            "description": "Accessibility consideration level",
            "options": ["basic", "enhanced", "full_compliance"],
            "requirements": {
              "basic": "readable_text, sufficient_contrast",
              "enhanced": "alt_text_ready, color_blind_friendly, clear_visual_hierarchy",
              "full_compliance": "WCAG_compliant, screen_reader_friendly, multiple_format_support"
            }
