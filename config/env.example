# Variables de entorno para MarketPro GT
# Copia este archivo como .env.local y configura tus valores reales

# Supabase Configuration
VITE_SUPABASE_URL=https://yitczogktdykcwjnejrt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_STABILITY_API_KEY=your_stability_api_key_here

# Social Media API Keys
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
VITE_FACEBOOK_APP_SECRET=your_facebook_app_secret_here
VITE_TWITTER_API_KEY=your_twitter_api_key_here
VITE_TWITTER_API_SECRET=your_twitter_api_secret_here
VITE_TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
VITE_TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# Analytics API Keys
VITE_GA4_ACCESS_TOKEN=your_ga4_access_token_here
VITE_YOUTUBE_ACCESS_TOKEN=your_youtube_access_token_here
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Video Generation API Keys
VITE_RUNWAY_API_KEY=your_runway_api_key_here
VITE_PIKA_API_KEY=your_pika_api_key_here
VITE_LUMA_API_KEY=your_luma_api_key_here

# External Service URLs
VITE_PLACEHOLDER_IMAGE_URL=https://via.placeholder.com
VITE_PICSUM_IMAGE_URL=https://picsum.photos
VITE_IP_SERVICE_URL=https://api.ipify.org?format=json

# API Configuration
VITE_FACEBOOK_API_VERSION=v23.0
VITE_YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
VITE_YOUTUBE_ANALYTICS_URL=https://youtubeanalytics.googleapis.com/v2

# Development Configuration
VITE_APP_ENV=development
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
