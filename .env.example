# Supabase Configuration
# Obtén estas credenciales desde tu proyecto en https://supabase.com
VITE_SUPABASE_URL=tu_url_de_supabase_aqui
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_de_supabase_aqui

# OpenAI API (opcional - para funcionalidades de IA)
VITE_OPENAI_API_KEY=tu_clave_openai_aqui

# Configuración de desarrollo (opcional)
# VITE_DEV_MODE=true
# VITE_API_BASE_URL=http://localhost:8000